---
import SectionRail from '../components/SectionRail.astro';
import LocationRow from '../components/LocationRow.astro';
import BackgroundVideo from '../components/BackgroundVideo.astro';
import { OFFICES, CONFIG, BRAND_ALT } from '../data/site';
import { asset } from '../lib/asset';

interface Props {
  useVideo?: boolean;
  showMap?: boolean;
}

const { useVideo = CONFIG.useVideo, showMap = CONFIG.showMap } = Astro.props;
---

<section id="network" class="network">
  {useVideo && <BackgroundVideo name="material-b" />}

  <div class="network__inner">
    {/* The comp centres both names on the map/address block rather than on the
        whole band — the lockup below is outside what they label. */}
    <SectionRail label="NETWORK" side="left" tone="inverse" class="network__rail network__rail--left" />
    <SectionRail label="拠点" side="right" tone="inverse" class="network__rail network__rail--right" />

    <div class="network__main">
      {
        showMap && (
          <picture class="network__map">
            <source srcset={asset('/assets/network/japan-map.webp')} type="image/webp" />
            {/* Outline, leader lines and the five place names are one piece of
                artwork — the comp only supplies them burnt together. */}
            <img
              src={asset('/assets/network/japan-map.png')}
              alt="国内拠点の地図。本社と上中工場は福井、ほかに金沢・京都・東京の営業所。"
              loading="lazy"
              decoding="async"
            />
          </picture>
        )
      }

      <div class="network__offices">
        {OFFICES.map((office) => <LocationRow office={office} />)}
      </div>
    </div>

    <div class="network__lockup">
      <picture>
        <source srcset={asset('/assets/brand/lockup-white.webp')} type="image/webp" />
        <img src={asset('/assets/brand/lockup-white.png')} alt={BRAND_ALT} loading="lazy" decoding="async" />
      </picture>
    </div>
  </div>
</section>

<style>
  .network {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--gradient-water);
  }

  .network__inner {
    position: relative;
    padding: var(--space-10) 0 var(--space-9);
  }

  /* Map and list are placed off the comp's own measures rather than shared out
     of a track, so each keeps its position as the viewport changes. The divider
     is drawn as a border on the list rather than as an element of its own. */
  .network__main {
    position: relative;
    display: grid;
    grid-template-columns: var(--network-map-w) 1fr;
    column-gap: calc(var(--network-list-left) - var(--network-map-left) - var(--network-map-w));
    align-items: start;
    padding-left: var(--network-map-left);
    padding-right: var(--network-list-right);
  }

  .network__map {
    display: block;
  }

  .network__map img {
    display: block;
    width: 100%;
    aspect-ratio: var(--network-map-ratio);
    height: auto;
  }

  .network__offices {
    display: grid;
    gap: var(--network-office-gap);
    /* The rule sits between the two, at the comp's x, and runs the block's full
       height — which is the list's height, the taller of the two by design. */
    border-left: var(--radius-hair) solid var(--text-inverse);
    padding-left: calc(var(--network-list-left) - var(--network-divider-x));
    margin-left: calc(var(--network-divider-x) - var(--network-list-left));
  }

  /* :global because these land on SectionRail's own root, which carries that
     component's scope id rather than this one's. Each rail is a band twice the
     inset wide pinned to its edge, so its centred label lands one inset in —
     and it spans only the main row, which is what centres it on that block. */
  .network__inner :global(.network__rail) {
    position: absolute;
    top: var(--space-10);
    height: var(--network-main-h, auto);
    width: calc(2 * var(--network-rail-inset));
    padding: 0;
    z-index: 1;
  }

  .network__inner :global(.network__rail--left) {
    left: 0;
  }

  .network__inner :global(.network__rail--right) {
    right: 0;
  }

  .network__lockup {
    display: flex;
    justify-content: center;
    padding: var(--space-9) 0 var(--space-8);
  }

  .network__lockup img {
    width: 420px;
    max-width: 60vw;
    height: auto;
  }

  @media (max-width: 768px) {
    .network__inner {
      padding: var(--space-9) var(--space-5);
    }

    .network__inner :global(.network__rail) {
      display: none;
    }

    /* Stacked: the map over the list, and the divider becomes the rule above it. */
    .network__main {
      grid-template-columns: 1fr;
      justify-items: center;
      row-gap: var(--space-9);
      padding: 0;
    }

    .network__map img {
      width: min(72vw, 320px);
    }

    .network__offices {
      gap: var(--space-7);
      border-left: 0;
      padding-left: 0;
      margin-left: 0;
    }

    .network__lockup {
      padding: var(--space-9) 0 var(--space-5);
    }
  }
</style>

<script>
  /**
   * The two section names centre on the map/address block, not on the whole
   * band — the lockup underneath is outside what they label. That block's
   * height is content-driven, so it is measured and handed to CSS.
   */
  const sections = document.querySelectorAll<HTMLElement>('.network__inner');

  for (const inner of sections) {
    const main = inner.querySelector<HTMLElement>('.network__main');
    if (!main) continue;

    const sync = (): void => {
      inner.style.setProperty('--network-main-h', `${main.offsetHeight}px`);
    };

    sync();
    new ResizeObserver(sync).observe(main);
  }
</script>
