---
import SectionRail from '../components/SectionRail.astro';
import LocationRow from '../components/LocationRow.astro';
import BackgroundVideo from '../components/BackgroundVideo.astro';
import { OFFICES, CONFIG, BRAND_ALT } from '../data/site';

interface Props {
  useVideo?: boolean;
  showMap?: boolean;
}

const { useVideo = CONFIG.useVideo, showMap = CONFIG.showMap } = Astro.props;
---

<section id="network" class="network">
  {useVideo && <BackgroundVideo name="material-b" />}

  <div class="network__inner">
    {/* Both rails span the two rows so they centre against the whole band. */}
    <SectionRail label="NETWORK" side="left" tone="inverse" class="network__rail" />

    <div class="network__main">
      <div class="network__offices">
        {OFFICES.map((office) => <LocationRow office={office} />)}
      </div>

      {
        showMap && (
          <picture class="network__map">
            <source srcset="/assets/works/japan-map.webp" type="image/webp" />
            <img src="/assets/works/japan-map.png" alt="国内拠点" loading="lazy" decoding="async" />
          </picture>
        )
      }
    </div>

    <SectionRail label="拠点" side="right" tone="inverse" class="network__rail network__rail--right" />

    <div class="network__lockup">
      <picture>
        <source srcset="/assets/brand/lockup-white.webp" type="image/webp" />
        <img src="/assets/brand/lockup-white.png" alt={BRAND_ALT} loading="lazy" decoding="async" />
      </picture>
    </div>
  </div>
</section>

<style>
  .network {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--gradient-water);
  }

  .network__inner {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail-col) 1fr var(--rail-col);
    padding: var(--space-10) 0 var(--space-9);
    align-items: stretch;
  }

  /* :global because these land on SectionRail's own root, which carries that
     component's scope id rather than this one's. */
  .network__inner :global(.network__rail) {
    grid-row: 1 / 3;
  }

  .network__inner :global(.network__rail--right) {
    grid-column: 3;
  }

  .network__main {
    grid-row: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
    align-items: center;
    gap: var(--space-8);
  }

  .network__offices {
    display: grid;
    gap: var(--space-6);
    padding-left: var(--space-8);
  }

  .network__map img {
    width: 100%;
    max-width: 380px;
    height: auto;
    opacity: 0.9;
  }

  .network__lockup {
    grid-row: 2;
    grid-column: 2;
    display: flex;
    justify-content: center;
    padding: var(--space-9) 0 var(--space-8);
  }

  .network__lockup img {
    width: 420px;
    max-width: 60vw;
    height: auto;
  }

  @media (max-width: 768px) {
    .network__inner {
      grid-template-columns: 1fr;
      padding: var(--space-9) var(--space-5);
    }

    .network__inner :global(.network__rail) {
      display: none;
    }

    .network__main {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: var(--space-9);
    }

    .network__offices {
      padding-left: 0;
      gap: var(--space-7);
    }

    .network__lockup {
      grid-row: auto;
      grid-column: auto;
      padding: var(--space-9) 0 var(--space-5);
    }
  }
</style>
