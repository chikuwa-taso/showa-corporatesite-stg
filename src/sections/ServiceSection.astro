---
import SectionRail from '../components/SectionRail.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import ServiceModal from '../components/ServiceModal.astro';
import { SERVICE_ROWS, CONFIG } from '../data/site';

const services = SERVICE_ROWS.flat();

interface Props {
  /**
   * Requested pictogram width. The rendered size shrinks below this whenever
   * the 3-up row would otherwise overflow, so it is a ceiling, not a promise.
   */
  iconSize?: number;
  showLabels?: boolean;
}

const { iconSize = CONFIG.iconSize, showLabels = CONFIG.serviceLabels } = Astro.props;
---

<section id="service" class="service" style={`--icon-size-base:${iconSize}px`}>
  <SectionRail label="SERVICE" side="left" />

  <div class="service__body">
    {
      SERVICE_ROWS.map((row) => (
        <div class="service__row">
          {row.map((service) => (
            <ServiceIcon slug={service.slug} label={service.label} showLabel={showLabels} />
          ))}
        </div>
      ))
    }
  </div>

  <SectionRail label="印刷方式" side="right" />
</section>

{/* Outside the section's grid — each one is fixed to the viewport when open, and
    keeping them out of the icon rows leaves that layout to the icons. */}
{services.map((service) => <ServiceModal service={service} />)}

<style>
  .service {
    display: grid;
    grid-template-columns: var(--rail-col) 1fr var(--rail-col);
    padding: var(--section-pad-y) 0;

    /* Row 1 is the binding one: three pictograms plus two gaps have to sit
       inside the rails. Past that width the icons give way, so the page never
       scrolls sideways. Declared here, not on :root, so the section's inline
       --icon-size-base (the prop) is the value that gets substituted. */
    --icon-size: min(
      var(--icon-size-base),
      calc((100vw - 2 * var(--rail-col) - 2 * var(--service-row-gap)) / 3)
    );
  }

  .service__body {
    display: flex;
    flex-direction: column;
    gap: var(--service-stack-gap);
    align-items: center;
  }

  .service__row {
    display: flex;
    gap: var(--service-row-gap);
    align-items: flex-end;
  }

  /* An open popup draws its own rails, and these would otherwise read faintly
     through the scrim a little off from them — one label printed twice. The
     pictograms are meant to show through; a second set of rails is not. */
  :global(html.has-modal) .service :global(.rail) {
    visibility: hidden;
  }

  @media (max-width: 768px) {
    .service {
      grid-template-columns: 1fr;
    }

    .service :global(.rail) {
      display: none;
    }

    /* The 3 + 2 rows would overflow a phone, so both wrap and centre instead —
       which makes the gutter, not the 3-up row, the constraint on size. */
    .service {
      --icon-size: min(
        calc(var(--icon-size-base) * var(--icon-mobile-scale)),
        calc(100vw - 2 * var(--space-5))
      );
    }

    .service__row {
      flex-wrap: wrap;
      justify-content: center;
      padding: 0 var(--space-5);
    }
  }
</style>
