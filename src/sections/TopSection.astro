---
import BackgroundVideo from '../components/BackgroundVideo.astro';
import { CONFIG, TOP_VIDEOS } from '../data/site';

interface Props {
  useVideo?: boolean;
}

const { useVideo = CONFIG.useVideo } = Astro.props;
---

{/* Brand impression only — no type, no scrim, no overlay. One of the three clips
    is dealt per page load, so the first thing a returning visitor sees is not
    always the same. Only the one dealt is ever downloaded. */}
<section id="top" class="top">
  {useVideo && <BackgroundVideo name={TOP_VIDEOS} />}
</section>

<style>
  .top {
    position: relative;
    width: 100%;
    height: var(--band-hero-h);
    overflow: hidden;
    /* Stands in whenever the video is off, still loading, or reduced-motion. */
    background: var(--gradient-fire);
  }
</style>
