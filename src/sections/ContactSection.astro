---
import LinkButton from '../components/LinkButton.astro';
import { route } from '../lib/asset';

const CTAS = [
  { label: '採用情報', href: route('/recruit') },
  { label: 'お問い合わせ', href: route('/contact') },
];
---

{/* The band mirrors the header: the same height, the same side gutters. The
    buttons stay centred as a pair, sized down a step so they sit in that
    shallower band without crowding it. */}
<footer id="contact" class="contact">
  {CTAS.map((cta) => <LinkButton class="contact__cta" href={cta.href}>{cta.label}</LinkButton>)}
</footer>

<style>
  .contact {
    display: flex;
    justify-content: center;
    align-items: center;
    /* The white band is the same depth as the header's — --header-h is what the
       header spacer uses, so the two bands measure the same at every width. The
       padding is the floor, for when stacking makes the content the taller of
       the two. */
    min-height: var(--header-h);
    gap: var(--footer-cta-gap);
    padding: var(--header-pad-top) var(--header-gutter) var(--header-pad-bottom);
    background: var(--surface-page);
  }

  /* LinkButton's root carries its own component id, so this component's scope
     will not reach it — the same reason NETWORK's rail needs :global. */
  .contact :global(.contact__cta) {
    font-size: var(--footer-cta-size);
    /* The bottom padding sets the gap down to the rule; keeping it proportional
       to the type stops the band growing back. (LinkButton keeps the rule to
       the width of the words.) */
    padding: 0 0 0.7em;
    white-space: nowrap;
  }

  /* Phones, per the comp: the two side by side, pushed out to 45px from each
     edge, in a band the header's depth. */
  @media (max-width: 768px) {
    .contact {
      justify-content: space-between;
      min-height: var(--footer-sp-h);
      gap: 0;
      padding: 0 var(--footer-sp-inset);
    }

    .contact :global(.contact__cta) {
      --link-button-track: var(--footer-sp-track);
      font-size: var(--footer-sp-size);
      line-height: 1;
      letter-spacing: var(--footer-sp-track);
      padding: 0 0 var(--footer-sp-rule-gap);
      /* The tracking after the last glyph would hold the right-hand button off
         the inset; the rule already stops short of it. */
      margin-right: calc(-1 * var(--footer-sp-track));
    }
  }
</style>
