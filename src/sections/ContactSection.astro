---
import LinkButton from '../components/LinkButton.astro';
import { route } from '../lib/asset';

const CTAS = [
  { label: '採用情報', href: route('/recruit') },
  { label: 'お問い合わせ', href: route('/contact') },
];
---

{/* The band mirrors the header: the same white above and below its content, and
    the same side gutters. The buttons stay centred as a pair, sized down a step
    so they sit in that shallower band without crowding it. */}
<footer id="contact" class="contact">
  {CTAS.map((cta) => <LinkButton class="contact__cta" href={cta.href}>{cta.label}</LinkButton>)}
</footer>

<style>
  .contact {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: var(--footer-cta-gap);
    padding: var(--header-pad-top) var(--header-gutter) var(--header-pad-bottom);
    background: var(--surface-page);
  }

  /* LinkButton's root carries its own component id, so this component's scope
     will not reach it — the same reason NETWORK's rail needs :global. */
  .contact :global(.contact__cta) {
    font-size: var(--footer-cta-size);
    /* The button's own padding is what sets the gap down to its rule; keeping it
       proportional to the type stops the band growing back. */
    padding: 0 2.9em 0.7em;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    /* Stacked into two rows, as the header is — and on the same vertical
       measure, so the two bands still read as a pair. */
    .contact {
      flex-direction: column;
      align-items: center;
      gap: var(--space-6);
      padding: var(--header-pad-top) var(--space-5) var(--header-pad-bottom);
    }
  }
</style>
