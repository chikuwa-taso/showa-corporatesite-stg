---
import BackgroundVideo from './BackgroundVideo.astro';
import { asset } from '../lib/asset';
import type { WorkTile } from '../data/site';

interface Props {
  tile: WorkTile;
  /** The duplicated half of the marquee is decorative to assistive tech. */
  duplicate?: boolean;
  useVideo?: boolean;
}

const { tile, duplicate = false, useVideo = true } = Astro.props;
---

<div
  class:list={['tile', `tile--${tile.ratio}`]}
  style={tile.kind === 'photo' ? undefined : `background:${tile.fill}`}
  aria-hidden={duplicate ? 'true' : undefined}
>
  {
    tile.kind === 'photo' && (
      <>
        <picture>
          <source srcset={asset(`${tile.src}.webp`)} type="image/webp" />
          {/* The marquee slides tiles in sideways rather than scrolling them into
              view, and a lazy image resolves too late to fill its slot — hence the
              eager first half. The duplicates reuse those same URLs, so they come
              straight from cache and can stay lazy. */}
          <img
            src={asset(`${tile.src}.jpg`)}
            alt={duplicate ? '' : tile.alt}
            loading={duplicate ? 'lazy' : 'eager'}
            fetchpriority="low"
            decoding="async"
          />
        </picture>

        {/* The colour field the tile wears at rest. Decorative — the photo
            underneath carries the alt text — and it lifts on hover. Supplied by
            the client and used at its original size, uncompressed. */}
        <img
          class="tile__lid"
          src={asset(tile.lid)}
          alt=""
          aria-hidden="true"
          loading={duplicate ? 'lazy' : 'eager'}
          fetchpriority="low"
          decoding="async"
        />
      </>
    )
  }
  {tile.kind === 'video' && useVideo && <BackgroundVideo name={tile.name} />}
</div>

<style>
  .tile {
    position: relative;
    flex: none;
    height: 100%;
    overflow: hidden;
  }

  .tile--photo {
    aspect-ratio: var(--tile-ratio-photo);
  }

  .tile--wide {
    aspect-ratio: var(--tile-ratio-wide);
  }

  .tile--square {
    aspect-ratio: var(--tile-ratio-square);
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile__lid {
    position: absolute;
    inset: 0;
  }

  /* Only where a pointer can actually hover. On a touch screen there is nothing
     to lift the lid with, so the tile shows its photograph from the start. */
  @media (hover: hover) {
    .tile__lid {
      opacity: 1;
      transition: opacity var(--dur-base) var(--ease-brand);
    }

    .tile:hover .tile__lid {
      opacity: 0;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    /* Still reveals, just without the cross-fade. */
    .tile__lid {
      transition: none;
    }
  }
</style>
