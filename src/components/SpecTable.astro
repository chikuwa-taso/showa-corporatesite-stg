---
import type { RecruitRow, RecruitCell } from '../data/site';

interface Props {
  rows: RecruitRow[];
  /** The mid-career table sizes to its content rather than filling the column. */
  fit?: boolean;
  class?: string;
}

const { rows, fit = false, class: className } = Astro.props;

/** Folds `sameLine` cells onto the line before them. */
function toLines(cells: RecruitCell[]): RecruitCell[][] {
  const lines: RecruitCell[][] = [];
  for (const cell of cells) {
    if (cell.sameLine && lines.length > 0) lines[lines.length - 1]!.push(cell);
    else lines.push([cell]);
  }
  return lines;
}
---

<div class="spec-scroll">
  <table class:list={['spec', fit && 'spec--fit', className]}>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row" class:list={[row.phoneLabelSmall && 'spec__th--sp-small']}>
              {row.label}
            </th>
            <td>
              {/* Rows with phone breaks carry both sets of lines; CSS shows one. */}
              {toLines(row.cells).map((line) => (
                <div class:list={['spec__line', row.phone && 'spec__pc']}>
                  {line.map((cell) =>
                    cell.small ? <span class="spec__small">{cell.text}</span> : <span>{cell.text}</span>,
                  )}
                </div>
              ))}
              {row.phone?.map((cell) => (
                <div class:list={['spec__line spec__sp', cell.tiny && 'spec__tiny']}>
                  <span class:list={[cell.small && 'spec__small']}>{cell.text}</span>
                </div>
              ))}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* The table keeps its own scroller so a narrow screen never pushes the page
     sideways — the brand has no icon to build a disclosure control from. */
  .spec-scroll {
    width: 100%;
    overflow-x: auto;
  }

  .spec {
    border-collapse: collapse;
    width: 100%;
    border: var(--radius-hair) solid var(--ink-900);
    font-family: var(--font-jp);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 2;
    letter-spacing: var(--ls-body);
    text-align: left;
  }

  .spec--fit {
    width: auto;
  }

  .spec th,
  .spec td {
    border: var(--radius-hair) solid var(--ink-900);
    padding: var(--space-3) var(--space-5);
    vertical-align: top;
  }

  .spec th {
    width: 220px;
    font-weight: var(--fw-medium);
  }

  .spec--fit th,
  .spec--fit td {
    padding: var(--space-4) var(--space-7);
  }

  .spec__line + .spec__line {
    margin-top: var(--space-2);
  }

  .spec__small {
    font-size: var(--fs-label);
  }

  .spec__sp {
    display: none;
  }

  /* Phones, per the comp (昭和サイト＿スマホ版デザイン＿採用情報表.jpg, a 375px
     screen; values in lp.css as --rt-sp-*): the table fits the screen with no
     sideways scroll, the cells break where the comp breaks them, and the type
     runs untracked at one size throughout. */
  @media (max-width: 768px) {
    .spec-scroll {
      overflow-x: visible;
    }

    /* Japanese face only: the comp's line lengths are Zen Kaku Gothic
       Antique's, digits included — Adapter Mono's wider figures would push
       several of its lines past the cell. */
    .spec {
      table-layout: fixed;
      font-family: 'Zen Kaku Gothic Antique', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif;
      font-size: var(--rt-sp-text);
      line-height: var(--rt-sp-line);
      letter-spacing: 0;
    }

    .spec--fit {
      width: 100%;
    }

    .spec th,
    .spec td,
    .spec--fit th,
    .spec--fit td {
      padding: var(--rt-sp-pad-y) var(--rt-sp-pad-right) var(--rt-sp-pad-y) var(--rt-sp-cell-x);
    }

    .spec th,
    .spec--fit th {
      width: var(--rt-sp-label-w);
      padding-left: var(--rt-sp-label-x);
      padding-right: 0;
    }

    .spec__th--sp-small {
      font-size: var(--rt-sp-label-small);
    }

    .spec__pc {
      display: none;
    }

    /* The breaks are the comp's; nothing else may break a line. */
    .spec__sp {
      display: block;
      white-space: nowrap;
    }

    .spec__line + .spec__line {
      margin-top: 0;
    }

    .spec__small {
      font-size: var(--rt-sp-small);
    }

    /* On the line itself, not a span inside it, so the line box shrinks with
       the type — the comp's row is that much shallower. */
    .spec__tiny {
      font-size: var(--rt-sp-tiny);
    }
  }
</style>
