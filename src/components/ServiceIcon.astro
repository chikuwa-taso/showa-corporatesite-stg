---
interface Props {
  slug: string;
  label: string;
  showLabel?: boolean;
}

const { slug, label, showLabel = false } = Astro.props;
---

{/* Brand illustrations, not UI glyphs — never recolored, never substituted. */}
<figure class="service-icon">
  <picture>
    <source srcset={`/assets/icons/${slug}.webp`} type="image/webp" />
    <img src={`/assets/icons/${slug}.png`} alt={label} loading="lazy" decoding="async" />
  </picture>
  {showLabel && <figcaption>{label}</figcaption>}
</figure>

<style>
  .service-icon {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .service-icon img {
    width: var(--icon-size);
    height: calc(var(--icon-size) * var(--icon-aspect));
    object-fit: contain;
  }

  .service-icon figcaption {
    font-family: var(--font-jp);
    font-size: var(--fs-label);
    font-weight: var(--fw-light);
    line-height: 1;
    letter-spacing: var(--ls-label);
    color: var(--text-body);
    white-space: nowrap;
  }
</style>
