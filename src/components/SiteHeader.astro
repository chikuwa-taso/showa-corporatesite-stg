---
import { NAV_ITEMS, BRAND_ALT, type PageId } from '../data/site';
import { asset, route } from '../lib/asset';

interface Props {
  /**
   * Set on the standalone pages, where the active item is fixed. Left unset on
   * the LP, whose active item follows the scroll instead.
   */
  activePage?: PageId;
}

const { activePage } = Astro.props;
---

<div class="header-bar">
  <header class="header">
    {/* The lockup is drawn twice from one file. The first copy is clipped to the
        kanji — the part that sits on the white band — and the second to the
        Latin line that hangs below it, so only that line can be recoloured when
        the page behind it is dark. */}
    <a class="header__logo" href={route('/#top')}>
      <picture class="header__logo-kanji">
        <source srcset={asset('/assets/brand/lockup.webp')} type="image/webp" />
        <img src={asset('/assets/brand/lockup.png')} alt={BRAND_ALT} width="456" height="261" />
      </picture>
      <picture class="header__logo-tail" data-logo-tail aria-hidden="true">
        <source srcset={asset('/assets/brand/lockup.webp')} type="image/webp" />
        <img src={asset('/assets/brand/lockup.png')} alt="" width="456" height="261" />
      </picture>
    </a>

    {/* Phones only: the comp puts a menu toggle where the nav row sits on PC.
        The three bars are drawn in CSS — the brand supplies no glyph for it. */}
    <button
      class="header__menu"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="メニューを開く"
      data-menu-toggle
    >
      <span class="header__menu-bar"></span>
      <span class="header__menu-bar"></span>
      <span class="header__menu-bar"></span>
    </button>

    <nav class="nav" id="site-nav" aria-label="サイト内ナビゲーション">
      {
        NAV_ITEMS.map((item) => {
          const isActive = activePage !== undefined && item.page === activePage;
          return (
            <a
              class:list={['nav__link', isActive && 'is-active']}
              href={route(item.href)}
              aria-current={isActive ? 'page' : undefined}
              data-spy-for={activePage === undefined ? item.section : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </header>
</div>

<div class="header-spacer"></div>

<style>
  .header-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--surface-page);
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    /* No padding under the logo: the band stops on the kanji's bottom edge, and
       --header-h is computed the same way, so the two must stay in step. */
    padding: var(--header-pad-top) var(--header-gutter) 0;
  }

  /* Keeps the fixed header from covering the top of the page. */
  .header-spacer {
    height: var(--header-h);
  }

  /* The box is only as tall as the kanji, so that is all the band accounts for.
     The image itself keeps its full height and spills out of the bottom —
     SHOWA ART PRINTING lands on the page below the white, with nothing painted
     behind it. Nothing clips it: the bar is `position: fixed`, so its containing
     block is the viewport rather than any ancestor that might scroll. */
  .header__logo {
    position: relative;
    flex: none;
    width: var(--logo-w);
    height: var(--logo-kanji-h);
    line-height: 0;
    display: block;
  }

  .header__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Both copies start at the anchor's top edge and run the full height of the
     artwork; the clips decide which band of it each one actually paints. */
  .header__logo-kanji,
  .header__logo-tail {
    display: block;
    width: 100%;
  }

  .header__logo-kanji {
    clip-path: inset(0 0 calc((1 - var(--logo-kanji-frac)) * 100%) 0);
  }

  .header__logo-tail {
    position: absolute;
    top: 0;
    left: 0;
    clip-path: inset(calc(var(--logo-kanji-frac) * 100%) 0 0 0);
  }

  /* Set by logo-contrast.ts when the page behind the hanging line is dark
     enough that black would be the harder of the two to read. The artwork is
     black on transparency, so inverting it yields white and leaves the
     transparency alone. */
  .header__logo-tail.is-on-dark {
    filter: invert(1);
  }

  .nav {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--header-nav-gap);
    /* The band has padding on top but none underneath, so centring in the
       content box would leave the nav sitting low. A bottom margin of the top
       padding lifts a centred item by half of it — exactly the offset — and
       puts the nav back on the band's own centre line. */
    margin-bottom: var(--header-pad-top);
  }

  .nav__link {
    font-family: var(--font-nav);
    font-size: var(--fs-label);
    font-weight: var(--fw-light);
    line-height: 1;
    letter-spacing: var(--ls-nav-mono);
    text-transform: uppercase;
    color: var(--text-body);
    opacity: 0.88;
    /* Transparent when inactive so the underline never shifts the layout. */
    border-bottom: var(--radius-hair) solid transparent;
    padding-bottom: var(--space-1);
    white-space: nowrap;
  }

  .nav__link.is-active {
    opacity: 1;
    border-bottom-color: currentColor;
  }

  .nav__link:hover {
    opacity: var(--hover-opacity);
  }

  /* The toggle only exists on phones. */
  .header__menu {
    display: none;
  }

  /* The phone header keeps the PC arrangement — kanji on the white band, the
     Latin line hanging below it — at the comp's phone sizes (lp.css), with the
     menu toggle where the nav row would be. The nav itself becomes the panel the
     toggle opens. */
  @media (max-width: 768px) {
    .header {
      align-items: flex-start;
    }

    /* Above the open menu panel, so the hanging Latin line stays on show. */
    .header__logo {
      z-index: 1;
    }

    .header__menu {
      position: relative;
      display: block;
      flex: none;
      width: var(--menu-toggle-w);
      height: calc(2 * var(--menu-toggle-pitch) + var(--menu-toggle-bar));
      /* The top bar sits 35px down the screen in the comp, not on the band's
         centre line. */
      margin-top: calc(var(--menu-toggle-top) - var(--header-pad-top));
      padding: 0;
      border: 0;
      background: none;
      color: var(--text-body);
      cursor: pointer;
    }

    /* A larger hit area than the glyph, without moving the glyph. */
    .header__menu::before {
      content: '';
      position: absolute;
      inset: calc(-1 * var(--space-3));
    }

    .header__menu-bar {
      position: absolute;
      left: 0;
      width: 100%;
      height: var(--menu-toggle-bar);
      background: currentColor;
      transition:
        transform var(--dur-fast) var(--ease-brand),
        opacity var(--dur-fast) var(--ease-brand);
    }

    .header__menu-bar:nth-child(1) {
      top: 0;
    }

    .header__menu-bar:nth-child(2) {
      top: var(--menu-toggle-pitch);
    }

    .header__menu-bar:nth-child(3) {
      top: calc(2 * var(--menu-toggle-pitch));
    }

    /* Open: the outer bars cross into an ×, the middle one drops out. */
    .header-bar.is-menu-open .header__menu-bar:nth-child(1) {
      transform: translateY(var(--menu-toggle-pitch)) rotate(45deg);
    }

    .header-bar.is-menu-open .header__menu-bar:nth-child(2) {
      opacity: 0;
    }

    .header-bar.is-menu-open .header__menu-bar:nth-child(3) {
      transform: translateY(calc(-1 * var(--menu-toggle-pitch))) rotate(-45deg);
    }

    /* The panel: white, from the band down, the links stacked under the
       hanging Latin line. */
    .nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      display: none;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: flex-start;
      justify-content: flex-start;
      gap: var(--space-6);
      margin: 0;
      padding: calc(var(--logo-tail-h) + var(--space-7)) var(--header-gutter) var(--space-7);
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--surface-page);
    }

    .header-bar.is-menu-open .nav {
      display: flex;
    }

    .nav__link {
      font-size: var(--fs-small);
    }

    @media (prefers-reduced-motion: reduce) {
      .header__menu-bar {
        transition: none;
      }
    }
  }
</style>

<script>
  import { initLogoContrast } from "../scripts/logo-contrast";
  import { initMenu } from "../scripts/menu";

  initLogoContrast();
  initMenu();
</script>
