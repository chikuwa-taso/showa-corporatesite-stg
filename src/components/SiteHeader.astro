---
import { NAV_ITEMS, BRAND_ALT, type PageId } from '../data/site';
import { asset, route } from '../lib/asset';

interface Props {
  /**
   * Set on the standalone pages, where the active item is fixed. Left unset on
   * the LP, whose active item follows the scroll instead.
   */
  activePage?: PageId;
}

const { activePage } = Astro.props;
---

<div class="header-bar">
  <header class="header">
    {/* The lockup is drawn twice from one file. The first copy is clipped to the
        kanji — the part that sits on the white band — and the second to the
        Latin line that hangs below it, so only that line can be recoloured when
        the page behind it is dark. */}
    <a class="header__logo" href={route('/#top')}>
      <picture class="header__logo-kanji">
        <source srcset={asset('/assets/brand/lockup.webp')} type="image/webp" />
        <img src={asset('/assets/brand/lockup.png')} alt={BRAND_ALT} width="456" height="261" />
      </picture>
      <picture class="header__logo-tail" data-logo-tail aria-hidden="true">
        <source srcset={asset('/assets/brand/lockup.webp')} type="image/webp" />
        <img src={asset('/assets/brand/lockup.png')} alt="" width="456" height="261" />
      </picture>
    </a>

    <nav class="nav" aria-label="サイト内ナビゲーション">
      {
        NAV_ITEMS.map((item) => {
          const isActive = activePage !== undefined && item.page === activePage;
          return (
            <a
              class:list={['nav__link', isActive && 'is-active']}
              href={route(item.href)}
              aria-current={isActive ? 'page' : undefined}
              data-spy-for={activePage === undefined ? item.section : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </header>
</div>

<div class="header-spacer"></div>

<style>
  .header-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--surface-page);
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    /* No padding under the logo: the band stops on the kanji's bottom edge, and
       --header-h is computed the same way, so the two must stay in step. */
    padding: var(--header-pad-top) var(--header-gutter) 0;
  }

  /* Keeps the fixed header from covering the top of the page. */
  .header-spacer {
    height: var(--header-h);
  }

  /* The box is only as tall as the kanji, so that is all the band accounts for.
     The image itself keeps its full height and spills out of the bottom —
     SHOWA ART PRINTING lands on the page below the white, with nothing painted
     behind it. Nothing clips it: the bar is `position: fixed`, so its containing
     block is the viewport rather than any ancestor that might scroll. */
  .header__logo {
    position: relative;
    flex: none;
    width: var(--logo-w);
    height: var(--logo-kanji-h);
    line-height: 0;
    display: block;
  }

  .header__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Both copies start at the anchor's top edge and run the full height of the
     artwork; the clips decide which band of it each one actually paints. */
  .header__logo-kanji,
  .header__logo-tail {
    display: block;
    width: 100%;
  }

  .header__logo-kanji {
    clip-path: inset(0 0 calc((1 - var(--logo-kanji-frac)) * 100%) 0);
  }

  .header__logo-tail {
    position: absolute;
    top: 0;
    left: 0;
    clip-path: inset(calc(var(--logo-kanji-frac) * 100%) 0 0 0);
  }

  /* Set by logo-contrast.ts when the page behind the hanging line is dark
     enough that black would be the harder of the two to read. The artwork is
     black on transparency, so inverting it yields white and leaves the
     transparency alone. */
  .header__logo-tail.is-on-dark {
    filter: invert(1);
  }

  .nav {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--header-nav-gap);
    /* The band has padding on top but none underneath, so centring in the
       content box would leave the nav sitting low. A bottom margin of the top
       padding lifts a centred item by half of it — exactly the offset — and
       puts the nav back on the band's own centre line. */
    margin-bottom: var(--header-pad-top);
  }

  .nav__link {
    font-family: var(--font-nav);
    font-size: var(--fs-label);
    font-weight: var(--fw-light);
    line-height: 1;
    letter-spacing: var(--ls-nav-mono);
    text-transform: uppercase;
    color: var(--text-body);
    opacity: 0.88;
    /* Transparent when inactive so the underline never shifts the layout. */
    border-bottom: var(--radius-hair) solid transparent;
    padding-bottom: var(--space-1);
    white-space: nowrap;
  }

  .nav__link.is-active {
    opacity: 1;
    border-bottom-color: currentColor;
  }

  .nav__link:hover {
    opacity: var(--hover-opacity);
  }

  @media (max-width: 768px) {
    .header {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      /* The gutter moves onto the children so the nav can scroll edge to edge;
         the vertical measure stays on the tokens, which the footer mirrors. */
      padding: var(--header-pad-top) 0 var(--header-pad-bottom);
    }

    /* --logo-kanji-frac is 1 here, so the box is the whole lockup again and
       nothing hangs below. */
    .header__logo {
      margin-left: var(--header-gutter);
    }

    .nav {
      /* The band has its bottom padding back, so the centring compensation
         above is not wanted. */
      margin-bottom: 0;
    }

    /* Seven items never fit a phone row. They stay one row that scrolls, since
       the brand supplies no icon to build a menu toggle from. */
    .nav {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: var(--space-5);
      overflow-x: auto;
      scrollbar-width: none;
      padding: 0 var(--header-gutter) var(--space-1);
    }

    .nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  import { initLogoContrast } from "../scripts/logo-contrast";

  initLogoContrast();
</script>
