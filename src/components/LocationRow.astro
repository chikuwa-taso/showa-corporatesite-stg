---
import type { Office } from '../data/site';

interface Props {
  office: Office;
}

const { office } = Astro.props;
---

{/* The 拠点 comp drops the MAP link that the earlier full-site comp carried, so
    the address is plain text here. mapHref() in data/site.ts still builds the
    Maps URL if it is ever wanted back. */}
<div class="location">
  <div class="location__name">{office.name}</div>
  <div>
    <div class="location__line">{office.postal}　{office.address}</div>
    <div class="location__line">
      <span>TEL {office.tel}</span>{office.fax && <span>　FAX {office.fax}</span>}
    </div>
  </div>
</div>

<style>
  .location {
    display: grid;
    /* Comp: the name sits at 46.67vw and the detail column opens at 59.76vw. */
    grid-template-columns: var(--network-name-col) 1fr;
  }

  .location__name,
  .location__line {
    font-family: var(--font-jp);
    font-size: var(--network-text);
    font-weight: var(--fw-medium);
    line-height: var(--network-line);
    letter-spacing: var(--ls-body);
    color: var(--text-inverse);
  }

  @media (max-width: 768px) {
    .location {
      grid-template-columns: 1fr;
      row-gap: var(--space-1);
    }
  }
</style>
