---
import LinkButton from './LinkButton.astro';
import SectionRail from './SectionRail.astro';
import { asset, route } from '../lib/asset';
import { FACILITY_HREF, type Service } from '../data/site';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const titleId = `service-modal-${service.slug}-title`;
---

{/*
  A native <dialog>: Esc, the focus trap and the inert background come free, and
  the top layer puts it over the page without a z-index race. It starts below the
  fixed header and leaves ::backdrop transparent, so the header stays crisp the
  way the comp draws it while everything under the popup dims to the scrim.

  The client supplied each panel as one flat composite with the title and copy
  burnt into the photo. Only the photo is used; the words are set live so they
  stay legible on a phone, selectable, and reachable by a screen reader — but
  with the comp's exact sizes, tracking and column breaks (see lp.css).
*/}
<dialog class="modal" id={`service-modal-${service.slug}`} aria-labelledby={titleId}>
  {/* The section's own rails sit behind the scrim and go faint with everything
      else, but the comp keeps them crisp — so the popup carries its own pair on
      the same grid the section uses, landing them in exactly the same place. */}
  <SectionRail label="SERVICE" side="left" />

  <div class="modal__composition">
    <picture class="modal__photo">
      <source srcset={asset(`/assets/service/${service.slug}.webp`)} type="image/webp" />
      {/* Lazy inside a closed dialog costs nothing until it opens; the icon
          warms it on hover so the panel is rarely caught mid-load. */}
      <img
        src={asset(`/assets/service/${service.slug}.jpg`)}
        alt={service.photoAlt}
        loading="lazy"
        decoding="async"
      />
    </picture>

    <p class="modal__body">
      {
        service.bodyLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </p>

    <h2
      class="modal__title"
      id={titleId}
      style={service.titleTrack ? `--popup-title-track:${service.titleTrack}` : undefined}
    >
      {
        service.titleLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </h2>

    {/* 設備一覧 and × travel as one unit anchored to the heading's first
        column: the comp centres × on that column and holds the rule's right
        edge 372px left of its centre, whether the heading is one column or two.
        The anchor is a zero-size grid item at the heading track's end, so the
        unit can hang leftward across the gap without widening the track. */}
    <div class="modal__actions">
      <div class="modal__actions-inner">
        {/* The tracking sits on an inner span so its trailing space can be
            pulled back off the end — otherwise the underline overhangs the last
            glyph by a full character, and the comp has the rule flush. */}
        <LinkButton class="modal__facility" href={route(FACILITY_HREF)}>
          <span class="modal__facility-label">設備一覧</span>
        </LinkButton>

        <button class="modal__close" type="button" data-modal-close autofocus aria-label="閉じる">
          <picture>
            <source srcset={asset('/assets/icons/close.webp')} type="image/webp" />
            <img src={asset('/assets/icons/close.png')} alt="" loading="lazy" decoding="async" />
          </picture>
        </button>
      </div>
    </div>
  </div>

  <SectionRail label="印刷技術" side="right" />
</dialog>

<style>
  .modal {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    /* Same three-column frame as the SERVICE section, so the popup's rails land
       on top of the ones showing faintly through the scrim. */
    display: grid;
    grid-template-columns: var(--rail-col) 1fr var(--rail-col);
    /* A dialog is width:fit-content and centred by default; override so it can
       fill the space under the header. */
    max-width: none;
    max-height: none;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--popup-scrim);
    color: var(--text-body);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .modal::backdrop {
    /* The scrim lives on the dialog itself, which starts below the header —
       dimming the backdrop too would take the header down with it. */
    background: transparent;
  }

  .modal:not([open]) {
    display: none;
  }

  .modal__composition {
    grid-column: 2;
    display: grid;
    grid-template-columns: auto auto auto; /* photo | copy | heading */
    grid-template-rows: auto auto; /* content | actions anchor */
    column-gap: var(--popup-gap-copy-title);
    justify-content: center;
    align-content: center;
    min-height: 100%;
    padding: var(--space-7) var(--space-5);
  }

  .modal__photo {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    /* The photo→copy gap is wider than the copy→heading gap, and grid has one
       column-gap — the difference rides on the photo. */
    margin-inline-end: calc(var(--popup-gap-photo-copy) - var(--popup-gap-copy-title));
    width: var(--popup-photo-w);
    aspect-ratio: var(--popup-photo-ratio);
  }

  .modal__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Comp alignment: the copy's first character tops the photo's top edge — in
     vertical writing the inline axis is vertical, so there is no leading above
     the first glyph and plain start alignment lands it exactly. */
  .modal__body {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    writing-mode: var(--writing-vertical);
    /* The comp sets C, T, P upright, one per em box, not rotated. */
    text-orientation: upright;
    font-family: var(--font-jp);
    font-size: var(--popup-body-size);
    font-weight: var(--fw-medium);
    line-height: var(--popup-body-line);
    letter-spacing: var(--popup-body-track);
  }

  .modal__title {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
    /* Hangs the heading's em-box top above the photo's top edge, per the comp. */
    margin: calc(-1 * var(--popup-title-rise)) 0 0;
    writing-mode: var(--writing-vertical);
    font-family: var(--font-display);
    font-size: var(--popup-title-size);
    font-weight: var(--fw-medium);
    line-height: var(--popup-title-line);
    letter-spacing: var(--popup-title-track);
  }

  /* The zero-size anchor: end of the heading track, bottom of the photo row. */
  .modal__actions {
    grid-column: 3;
    grid-row: 2;
    justify-self: end;
    position: relative;
    width: 0;
    height: 0;
  }

  /* Offsets in em of the heading, straight from the comp (values ÷ 221px em):
     × centres on the heading's first column (line-height/2 = 0.94em in, half a
     glyph back = 0.59em to its right edge); the flex gap of 1.33em then puts
     the rule's right edge 372px left of the × centre; the whole unit's bottom
     sits --popup-actions-drop below the photo's bottom edge. */
  .modal__actions-inner {
    position: absolute;
    right: calc(0.59 * var(--popup-title-size));
    bottom: calc(-1 * var(--popup-actions-drop));
    display: flex;
    align-items: flex-end;
    column-gap: calc(1.33 * var(--popup-title-size));
  }

  /* LinkButton's root carries its own component id, which Astro's scoping will
     not match from here — the same reason NETWORK's rail needs :global. */
  .modal__actions-inner :global(.modal__facility) {
    padding: 0 0 0.55em; /* comp: rule top 90px under the ink */
    border-bottom-width: 0.13em; /* comp: 19px rule */
    font-size: var(--popup-facility-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    white-space: nowrap;
  }

  .modal__facility-label {
    letter-spacing: var(--popup-facility-track);
    margin-inline-end: calc(-1 * var(--popup-facility-track));
  }

  .modal__close {
    width: calc(var(--popup-title-size) * 0.71); /* comp: 156px glyph */
    /* Hit area beyond the glyph, cancelled out of layout so the glyph's own
       edges are what the offsets above position. */
    padding: var(--space-2);
    margin: calc(-1 * var(--space-2));
    box-sizing: content-box;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .modal__close img {
    display: block;
    width: 100%;
  }

  .modal__close:hover {
    opacity: var(--hover-opacity);
  }

  .modal__close:active {
    opacity: var(--press-opacity);
  }

  @media (prefers-reduced-motion: no-preference) {
    .modal[open] {
      animation: modal-in var(--dur-fast) var(--ease-brand);
    }
  }

  @keyframes modal-in {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .modal {
      grid-template-columns: 1fr;
    }

    .modal :global(.rail) {
      display: none;
    }

    /* Stacked: photo, then the heading and copy side by side as one vertical
       block, then the actions row. The rows keep their reading order. */
    .modal__composition {
      grid-column: 1;
      grid-template-columns: auto auto;
      grid-template-rows: auto auto auto;
      column-gap: var(--space-6);
      row-gap: var(--space-6);
      justify-content: center;
      padding: var(--space-6) var(--space-5);
    }

    .modal__photo {
      grid-column: 1 / 3;
      grid-row: 1;
      margin-inline-end: 0;
    }

    .modal__body {
      grid-column: 1;
      grid-row: 2;
      justify-self: end;
    }

    .modal__title {
      grid-column: 2;
      grid-row: 2;
    }

    /* The anchor trick stands down: the actions become an ordinary centred row. */
    .modal__actions {
      grid-column: 1 / 3;
      grid-row: 3;
      justify-self: center;
      width: auto;
      height: auto;
    }

    .modal__actions-inner {
      position: static;
      column-gap: var(--space-7);
    }
  }
</style>
