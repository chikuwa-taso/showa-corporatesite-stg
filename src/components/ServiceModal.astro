---
import LinkButton from './LinkButton.astro';
import SectionRail from './SectionRail.astro';
import { asset, route } from '../lib/asset';
import { FACILITY_HREF, type Service } from '../data/site';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const titleId = `service-modal-${service.slug}-title`;
// Must match POPUP_WIDTHS in scripts/optimize-assets.sh.
const POPUP_WIDTHS = [960, 1440, 2000, 2600, 3426];
---

{/*
  A native <dialog>: Esc, the focus trap and the inert background come free, and
  the top layer puts it over the page without a z-index race. It starts below the
  fixed header and leaves ::backdrop transparent, so the header stays crisp the
  way the comp draws it while everything under the popup dims to the scrim.

  The client supplied each panel as one flat composite with the title and copy
  burnt into the photo. Only the photo is used; the words are set live so they
  stay legible on a phone, selectable, and reachable by a screen reader — but
  with the comp's exact sizes, tracking and column breaks (see lp.css).
*/}
{/*
  Opening focuses the dialog itself, not the ×. A tap on iOS never focuses the
  pictogram, so focus the browser moves into the panel reads as keyboard focus
  and matches :focus-visible — the × drew its focus ring on every phone open.
  A keyboard open still lands on the × (service-modal.ts).
*/}
<dialog
  class="modal"
  id={`service-modal-${service.slug}`}
  aria-labelledby={titleId}
  tabindex="-1"
  autofocus
>
  {/* The section's own rails sit behind the scrim and go faint with everything
      else, but the comp keeps them crisp — so the popup carries its own pair on
      the same grid the section uses, landing them in exactly the same place. */}
  <SectionRail label="SERVICE" side="left" />

  {/* Phones only. The dialog sits in the top layer from the band's bottom edge
      down, which would cover the Latin line hanging below the band — so it
      carries its own copy of that line, in exactly the same place. */}
  <picture class="modal__logo-tail" aria-hidden="true">
    <source srcset={asset('/assets/brand/lockup.webp')} type="image/webp" />
    <img src={asset('/assets/brand/lockup.png')} alt="" width="456" height="261" loading="lazy" decoding="async" />
  </picture>

  <div class="modal__composition">
    {/* The client's composite, cropped at its own 3426x1968 and shipped as a
        ladder of q90 WebPs (scripts/optimize-assets.sh, POPUP_WIDTHS). `sizes`
        mirrors --popup-photo-w / --popup-sp-photo-w, so a phone fetches the
        ~40–90KB rung and a Retina desktop the 2000px one rather than all 3426px.
        Lazy inside a closed dialog costs nothing until it opens; the icon warms
        it on hover (flipping loading to eager, which honours the same srcset). */}
    <img
      class="modal__photo"
      src={asset(`/assets/service/${service.slug}-2000.webp`)}
      srcset={POPUP_WIDTHS.map((w) => `${asset(`/assets/service/${service.slug}-${w}.webp`)} ${w}w`).join(', ')}
      sizes="(max-width: 768px) 82vw, 44.68vw"
      alt={service.photoAlt}
      loading="lazy"
      decoding="async"
    />

    <p class="modal__body">
      {
        service.bodyLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </p>

    <h2
      class="modal__title"
      id={titleId}
      style={service.titleTrack ? `--popup-title-track:${service.titleTrack}` : undefined}
    >
      {
        service.titleLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </h2>

    {/* 設備一覧 and × travel as one unit anchored to the heading's first
        column: the comp centres × on that column and holds the rule's right
        edge 372px left of its centre, whether the heading is one column or two.
        The anchor is a zero-size grid item at the heading track's end, so the
        unit can hang leftward across the gap without widening the track. */}
    <div class="modal__actions">
      <div class="modal__actions-inner">
        {/* The tracking sits on an inner span so its trailing space can be
            pulled back off the end — otherwise the underline overhangs the last
            glyph by a full character, and the comp has the rule flush. */}
        <LinkButton class="modal__facility" href={route(FACILITY_HREF)}>
          <span class="modal__facility-label">設備一覧</span>
        </LinkButton>

        <button class="modal__close" type="button" data-modal-close aria-label="閉じる">
          <picture>
            <source srcset={asset('/assets/icons/close.webp')} type="image/webp" />
            <img src={asset('/assets/icons/close.png')} alt="" loading="lazy" decoding="async" />
          </picture>
        </button>
      </div>
    </div>
  </div>

  <SectionRail label="印刷技術" side="right" />
</dialog>

<style>
  .modal {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    /* Same three-column frame as the SERVICE section, so the popup's rails land
       on top of the ones showing faintly through the scrim. */
    display: grid;
    grid-template-columns: var(--rail-col) 1fr var(--rail-col);
    /* A dialog is width:fit-content and centred by default; override so it can
       fill the space under the header. */
    max-width: none;
    max-height: none;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--popup-scrim);
    color: var(--text-body);
    overflow: auto;
    overscroll-behavior: contain;
  }

  /* The dialog takes focus only so it can be announced; a ring around the
     whole panel would mark nothing a person can act on. */
  .modal:focus {
    outline: none;
  }

  .modal::backdrop {
    /* The scrim lives on the dialog itself, which starts below the header —
       dimming the backdrop too would take the header down with it. */
    background: transparent;
  }

  .modal:not([open]) {
    display: none;
  }

  .modal__composition {
    grid-column: 2;
    display: grid;
    grid-template-columns: auto auto auto; /* photo | copy | heading */
    grid-template-rows: auto auto; /* content | actions anchor */
    column-gap: var(--popup-gap-copy-title);
    justify-content: center;
    align-content: center;
    min-height: 100%;
    padding: var(--space-7) var(--space-5);
  }

  .modal__photo {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    /* The photo→copy gap is wider than the copy→heading gap, and grid has one
       column-gap — the difference rides on the photo. */
    margin-inline-end: calc(var(--popup-gap-photo-copy) - var(--popup-gap-copy-title));
    width: var(--popup-photo-w);
    aspect-ratio: var(--popup-photo-ratio);
    /* The crop already is --popup-photo-ratio, so cover never actually crops —
       it only guards against the ratio token and the file drifting apart. */
    object-fit: cover;
  }

  /* Comp alignment: the copy's first character tops the photo's top edge — in
     vertical writing the inline axis is vertical, so there is no leading above
     the first glyph and plain start alignment lands it exactly. */
  .modal__body {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    writing-mode: var(--writing-vertical);
    /* The comp sets C, T, P upright, one per em box, not rotated. */
    text-orientation: upright;
    font-family: var(--font-jp);
    font-size: var(--popup-body-size);
    font-weight: var(--fw-medium);
    line-height: var(--popup-body-line);
    letter-spacing: var(--popup-body-track);
  }

  .modal__title {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
    /* Hangs the heading's em-box top above the photo's top edge, per the comp. */
    margin: calc(-1 * var(--popup-title-rise)) 0 0;
    writing-mode: var(--writing-vertical);
    font-family: var(--font-display);
    font-size: var(--popup-title-size);
    font-weight: var(--fw-medium);
    line-height: var(--popup-title-line);
    letter-spacing: var(--popup-title-track);
  }

  /* The zero-size anchor: end of the heading track, bottom of the photo row. */
  .modal__actions {
    grid-column: 3;
    grid-row: 2;
    justify-self: end;
    position: relative;
    width: 0;
    height: 0;
  }

  /* Offsets in em of the heading, straight from the comp (values ÷ 221px em):
     the × centres on the heading's first column, 0.94em in (line-height / 2),
     and the rule's right edge sits 372px = 1.683em left of that centre. Both
     are fixed to the ×'s CENTRE, so they hold whatever size the glyph is: its
     right edge is 0.94em less half its width, and the flex gap is 1.683em less
     half its width. The whole unit's bottom sits --popup-actions-drop below the
     photo's bottom edge. */
  .modal__actions-inner {
    position: absolute;
    right: calc(0.94 * var(--popup-title-size) - var(--popup-close-w) / 2);
    bottom: calc(-1 * var(--popup-actions-drop));
    display: flex;
    align-items: flex-end;
    column-gap: calc(1.683 * var(--popup-title-size) - var(--popup-close-w) / 2);
  }

  /* LinkButton's root carries its own component id, which Astro's scoping will
     not match from here — the same reason NETWORK's rail needs :global. */
  .modal__actions-inner :global(.modal__facility) {
    padding: 0 0 0.55em; /* comp: rule top 90px under the ink */
    --link-button-rule: 0.13em; /* comp: 19px rule */
    /* The label below already cancels its own trailing tracking. */
    --link-button-track: 0px;
    font-size: var(--popup-facility-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    white-space: nowrap;
  }

  .modal__facility-label {
    letter-spacing: var(--popup-facility-track);
    margin-inline-end: calc(-1 * var(--popup-facility-track));
  }

  .modal__close {
    width: var(--popup-close-w);
    /* Hit area beyond the glyph, cancelled out of layout so the glyph's own
       edges are what the offsets above position. */
    padding: var(--space-2);
    margin: calc(-1 * var(--space-2));
    box-sizing: content-box;
    background: none;
    border: 0;
    cursor: pointer;
    /* iOS gives a <button> system-blue text, and the focus ring is drawn in
       currentColor — so without this, the ring came out blue. */
    color: inherit;
    /* :active already dims the glyph; the grey tap flash would be a second box. */
    -webkit-tap-highlight-color: transparent;
  }

  .modal__close img {
    display: block;
    width: 100%;
  }

  .modal__close:hover {
    opacity: var(--hover-opacity);
  }

  .modal__close:active {
    opacity: var(--press-opacity);
  }

  @media (prefers-reduced-motion: no-preference) {
    .modal[open] {
      animation: modal-in var(--dur-fast) var(--ease-brand);
    }
  }

  @keyframes modal-in {
    from {
      opacity: 0;
    }
  }

  .modal__logo-tail {
    display: none;
  }

  /* Phones, per the comp: the photo across the top; under it the heading in
     one column at the right with the copy beside it, and 設備一覧 — ruled down
     its right side — over the × at the left. */
  @media (max-width: 768px) {
    /* minmax(0, …): the popup is never wider than the screen, whatever its
       content measures. */
    .modal {
      grid-template-columns: minmax(0, 1fr);
    }

    .modal :global(.rail) {
      display: none;
    }

    .modal__logo-tail {
      position: absolute;
      top: calc(-1 * var(--logo-kanji-h));
      left: var(--header-gutter);
      display: block;
      width: var(--logo-w);
      clip-path: inset(calc(var(--logo-kanji-frac) * 100%) 0 0 0);
      pointer-events: none;
    }

    .modal__logo-tail img {
      display: block;
      width: 100%;
      height: auto;
    }

    .modal__composition {
      grid-column: 1;
      grid-template-columns: auto 1fr auto auto; /* actions | space | copy | heading */
      grid-template-rows: auto auto;
      column-gap: 0;
      justify-content: stretch;
      align-content: start;
      /* The board itself: 100 units wide, centred, with every measure inside
         it in the same units (lp.css) — so when a short screen shrinks it, it
         shrinks as one piece and keeps the comp's proportions. */
      justify-self: center;
      width: calc(100 * var(--pu));
      min-height: 0;
      padding: var(--popup-sp-photo-top) 0 var(--popup-sp-pad-bottom);
    }

    .modal__photo {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
      width: var(--popup-sp-photo-w);
      margin: 0;
    }

    /* The column breaks are fixed (bodyLines), so nothing may wrap. Left to
       wrap, a vertical block's line length falls back to a guess the engines
       disagree on — Safari broke these into four and five columns, and the
       wider block pushed the whole popup past the screen's edge. */
    .modal__body {
      grid-column: 3;
      grid-row: 2;
      align-self: start;
      white-space: nowrap;
      margin: var(--popup-sp-block-top) var(--popup-sp-body-gap) 0 0;
      font-size: var(--popup-sp-body-size);
      line-height: var(--popup-sp-body-line);
      letter-spacing: var(--popup-sp-body-track);
    }

    /* One column here: every heading fits the phone's height in one. */
    .modal__title {
      grid-column: 4;
      grid-row: 2;
      margin: var(--popup-sp-block-top) var(--popup-sp-title-right) 0 0;
      font-size: var(--popup-sp-title-size);
      line-height: 1;
      white-space: nowrap;
      letter-spacing: var(--popup-sp-title-track);
    }

    .modal__title br {
      display: none;
    }

    /* The anchor trick stands down: the actions are an ordinary column. */
    .modal__actions {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
      align-self: start;
      width: auto;
      height: auto;
      margin: var(--popup-sp-block-top) 0 0 var(--popup-sp-facility-left);
    }

    .modal__actions-inner {
      position: static;
      flex-direction: column;
      align-items: center;
      row-gap: var(--popup-sp-close-gap);
      column-gap: 0;
    }

    /* Set vertically, so the rule runs down the right of the words rather than
       under them — 1px, the words' own length. */
    .modal__actions-inner :global(.modal__facility) {
      writing-mode: var(--writing-vertical);
      padding: 0 var(--popup-sp-rule-gap) 0 0;
      font-size: var(--popup-sp-facility-size);
      background-position: 100% 0;
      background-size: var(--radius-hair) 100%;
    }

    .modal__facility-label {
      letter-spacing: var(--popup-sp-facility-track);
      margin-inline-end: calc(-1 * var(--popup-sp-facility-track));
    }

    .modal__close {
      width: var(--popup-sp-close-w);
    }
  }
</style>
