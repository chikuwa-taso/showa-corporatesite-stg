---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

{/* The brand's only button: a hairline-underlined text link. */}
<a class:list={['link-button', className]} href={href}><slot /></a>

<style>
  .link-button {
    display: inline-block;
    padding: 0 var(--space-8) var(--space-4);
    font-family: var(--font-jp);
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: var(--ls-heading);
    color: var(--text-body);
    border-bottom: var(--radius-hair) solid var(--border-hairline);
  }

  @media (max-width: 768px) {
    .link-button {
      padding: 0 var(--space-6) var(--space-3);
    }
  }
</style>
