---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LinkButton from '../components/LinkButton.astro';
import SectionRail from '../components/SectionRail.astro';
import { asset, route } from '../lib/asset';
import { DEPARTMENTS } from '../data/facility';

/** Frames are measured on the 7681px board; 76.81 board px is 1vw. */
const BOARD_PER_VW = 76.81;
const FRAME_H = 1004;
---

<BaseLayout
  title="設備一覧｜昭和美術印刷株式会社"
  description="昭和美術印刷の保有設備。オフセット輪転印刷、枚葉印刷、オンデマンド印刷、プリプレス、製本・折加工・PP加工・型抜き加工の各部門の設備を掲載しています。"
  noindex
>
  <SiteHeader activePage="facility" />

  <main class="facility">
    {/* The side column — both rails and the pictogram index — stays put while
        the page scrolls. It shares one grid cell with the content, so it takes
        no room of its own; and because it keeps its real height, sticky lets go
        of it as the black ground ends rather than letting it ride over the
        footer. */}
    <div class="fac-side">
      <SectionRail label="EQUIPMENT" side="left" tone="inverse" class="fac-side__rail fac-side__rail--left" />

      <nav class="fac-nav" aria-label="部門">
        {
          DEPARTMENTS.map((d, i) => (
            <a
              class:list={['fac-nav__item', i === 0 && 'is-active']}
              href={`#fac-${d.id}`}
              data-fac-nav={d.id}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <picture>
                <source srcset={asset(`/assets/facility/icon-${d.icon}.webp`)} type="image/webp" />
                <img src={asset(`/assets/facility/icon-${d.icon}.png`)} alt={d.title} />
              </picture>
            </a>
          ))
        }
      </nav>

      <SectionRail label="設備一覧" side="right" tone="inverse" class="fac-side__rail fac-side__rail--right" />
    </div>

    <div class="facility__content">
      {
        DEPARTMENTS.map((d) => (
          <section class="dept" id={`fac-${d.id}`} data-fac-section={d.id} aria-labelledby={`fac-${d.id}-title`}>
            <header class="dept__head">
              <picture>
                <source srcset={asset(`/assets/facility/icon-${d.icon}.webp`)} type="image/webp" />
                <img class="dept__icon" src={asset(`/assets/facility/icon-${d.icon}.png`)} alt="" />
              </picture>
              <p class="dept__tag">{d.tagline}</p>
              <h2 class="dept__title" id={`fac-${d.id}-title`}>{d.title}</h2>
            </header>

            <div class:list={['dept__tree', !d.body && 'dept__tree--bare']}>
              {d.body && (
                <div class="dept__intro">
                  {d.body.map((line) => (
                    <p>{line}</p>
                  ))}
                </div>
              )}

              <ul class="dept__machines">
                {d.machines.map((m) => (
                  <li class:list={['machine', m.photo && 'machine--photo']}>
                    <p class="machine__head">
                      <span class="machine__name">{m.name}</span>
                      {m.spec && <span class="machine__spec">{m.spec}</span>}
                    </p>
                    {m.notes?.map((n) => (
                      <p class="machine__note">{n}</p>
                    ))}
                    {m.photo && (
                      <div
                        class="machine__frame"
                        style={`--frame-w:${(m.photo.boardW / BOARD_PER_VW).toFixed(2)}vw;--frame-ratio:${m.photo.boardW} / ${FRAME_H}`}
                      >
                        <img
                          src={asset(`/assets/facility/${m.photo.src}.webp`)}
                          alt={m.photo.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>
  </main>

  <footer class="page-footer">
    <LinkButton href={route('/#top')}>トップへ戻る</LinkButton>
  </footer>
</BaseLayout>

<script>
  import { initFacilityNav } from '../scripts/facility-nav';

  initFacilityNav();
</script>

<style>
  .facility {
    position: relative;
    display: grid;
    background: var(--fac-ground);
    color: var(--fac-ink);
  }

  .fac-side,
  .facility__content {
    grid-area: 1 / 1;
  }

  .page-footer {
    display: flex;
    justify-content: center;
    padding: var(--space-9) 0 var(--space-10);
    background: var(--surface-page);
  }

  /* ---------------------------------------------------------------- side */

  .fac-side {
    --side-h: calc(var(--fac-side-centre) + 2 * var(--fac-nav-pitch) + var(--fac-nav-ring));
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    align-self: start;
    height: var(--side-h);
    pointer-events: none;
  }

  /* Each rail is a band twice the inset wide pinned to its edge, so its label
     centres one inset in — the arrangement WORKS and NETWORK use — and on the
     same line as the middle pictogram. SectionRail's root is another
     component's element, hence :global. */
  .fac-side :global(.fac-side__rail) {
    position: absolute;
    top: var(--fac-side-centre);
    width: 10%;
    padding: 0;
    transform: translateY(-50%);
  }

  .fac-side :global(.fac-side__rail--left) {
    left: 0;
  }

  .fac-side :global(.fac-side__rail--right) {
    right: 0;
  }

  .fac-nav {
    position: absolute;
    left: calc(var(--fac-nav-x) - var(--fac-nav-ring) / 2);
    top: calc(var(--fac-side-centre) - 2 * var(--fac-nav-pitch) - var(--fac-nav-ring) / 2);
    display: flex;
    flex-direction: column;
    gap: calc(var(--fac-nav-pitch) - var(--fac-nav-ring));
    pointer-events: auto;
  }

  /* The ring is the item's own border, transparent until it is the section in
     view, so marking one never moves anything. */
  .fac-nav__item {
    display: grid;
    place-items: center;
    width: var(--fac-nav-ring);
    height: var(--fac-nav-ring);
    border: var(--fac-stroke) solid transparent;
    border-radius: 50%;
    box-sizing: border-box;
    transition: border-color var(--dur-fast) var(--ease-brand);
  }

  .fac-nav__item.is-active {
    border-color: var(--fac-ink);
  }

  .fac-nav__item:hover {
    opacity: var(--hover-opacity);
  }

  .fac-nav__item :global(picture),
  .fac-nav__item img {
    display: block;
  }

  .fac-nav__item img {
    height: var(--fac-nav-icon);
    width: auto;
  }

  /* -------------------------------------------------------------- content */

  .facility__content {
    padding: var(--fac-page-top) 0 var(--fac-page-bottom) var(--fac-tree-x);
  }

  .dept {
    /* Land a jump from the index where the comp puts a heading: the same depth
       below the header as the first one sits on load. */
    scroll-margin-top: var(--fac-page-top);
  }

  .dept + .dept {
    margin-top: var(--fac-section-gap);
  }

  /* Pictogram on the rule's line, tagline and title one column across; the
     tagline's top on the pictogram's top. */
  .dept__head {
    position: relative;
    min-height: var(--fac-icon);
    padding-left: var(--fac-head-x);
  }

  .dept__head :global(picture) {
    position: absolute;
    left: 0.21vw; /* x 1823, a hair right of the rule */
    top: 0;
  }

  .dept__icon {
    display: block;
    height: var(--fac-icon);
    width: auto;
  }

  .dept__tag {
    margin: 0;
    font-size: var(--fac-tag-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--fac-tag-track);
  }

  .dept__title {
    margin: calc(var(--fac-title-top) - var(--fac-tag-size)) 0 0;
    font-size: var(--fac-title-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--fac-title-track);
  }

  /* ----------------------------------------------------------------- tree */

  .dept__tree {
    margin-top: var(--fac-head-to-tree);
  }

  /* The body and the divider under it make one corner: the tree's rule on the
     left, the divider along the bottom, meeting square. */
  .dept__intro {
    width: var(--fac-tree-w);
    box-sizing: border-box;
    padding: 0 0 var(--fac-body-to-divider) var(--fac-text-x);
    border-left: var(--fac-stroke) solid var(--fac-ink);
    border-bottom: var(--fac-stroke) solid var(--fac-ink);
  }

  .dept__intro p {
    margin: 0;
    font-size: var(--fac-body-size);
    font-weight: var(--fw-medium);
    line-height: var(--fac-body-line);
    letter-spacing: var(--fac-body-track);
  }

  .dept__intro p:first-child {
    margin-top: calc(-1 * var(--fac-body-lift));
  }

  /* The comp's line breaks are deliberate — each entry is one line, and the
     longest (枚葉's third) runs a little past the divider's end in the comp
     itself. So lines do not re-wrap while the type is still at the comp's share
     of the window. Below 1200px the 11px floor takes over, the text no longer
     scales with the column, and it is allowed to wrap. */
  @media (min-width: 1200px) {
    .dept__intro p {
      white-space: nowrap;
    }
  }

  .dept__machines {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each item carries its own length of the rule (::before, full height) and
     its stub (::after, on the name's centre line); the last one's rule stops at
     its stub, which closes the tree into an └. --pt is the item's top padding,
     named so both pseudo-elements can find the name's line from it. */
  .machine {
    --pt: var(--fac-item-gap);
    position: relative;
    padding: var(--pt) 0 0 var(--fac-text-x);
  }

  .machine:first-child {
    --pt: var(--fac-divider-to-first);
  }

  .dept__tree--bare .machine:first-child {
    --pt: var(--fac-tree-to-first);
  }

  .machine--photo + .machine {
    --pt: var(--fac-after-frame);
  }

  .machine::before,
  .machine::after {
    content: '';
    position: absolute;
    left: 0;
    background: var(--fac-ink);
  }

  .machine::before {
    top: 0;
    bottom: 0;
    width: var(--fac-stroke);
  }

  .machine:last-child::before {
    bottom: auto;
    height: calc(var(--pt) + var(--fac-name-size) / 2 + var(--fac-stroke) / 2);
  }

  .machine::after {
    top: calc(var(--pt) + var(--fac-name-size) / 2 - var(--fac-stroke) / 2);
    width: var(--fac-stub);
    height: var(--fac-stroke);
  }

  .machine__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--fac-spec-gap);
    margin: 0;
  }

  .machine__name {
    font-size: var(--fac-name-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--fac-name-track);
  }

  .machine__spec {
    font-size: var(--fac-body-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--fac-spec-track);
  }

  .machine__note {
    margin: 0;
    font-size: var(--fac-note-size);
    font-weight: var(--fw-medium);
    line-height: var(--fac-note-line);
    letter-spacing: var(--fac-note-track);
  }

  .machine__head + .machine__note {
    margin-top: var(--fac-name-to-notes);
  }

  .machine__frame {
    width: var(--frame-w);
    max-width: 100%;
    aspect-ratio: var(--frame-ratio);
    margin-top: var(--fac-to-frame);
    border: var(--fac-stroke) solid var(--fac-ink);
    box-sizing: border-box;
  }

  .machine__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --------------------------------------------------------------- mobile */

  /* No phone artboard was drawn. The index turns into a row pinned under the
     header, the rails go, and the tree keeps its shape at a readable size
     (the sizes themselves are set in lp.css). */
  @media (max-width: 768px) {
    /* Stacked instead: the index sits in the flow above the content. */
    .facility {
      display: block;
    }

    .fac-side {
      height: auto;
      padding: var(--space-3) 0;
      background: var(--fac-ground);
    }

    .fac-side :global(.fac-side__rail) {
      display: none;
    }

    .fac-nav {
      position: static;
      flex-direction: row;
      justify-content: center;
      gap: var(--space-3);
    }

    .facility__content {
      padding-right: var(--space-5);
    }

    .dept {
      scroll-margin-top: calc(var(--fac-nav-ring) + 2 * var(--space-3) + var(--space-5));
    }

    .dept__intro {
      width: 100%;
    }

    /* Every frame takes the column's width; each keeps its own proportions. */
    .machine__frame {
      width: 100%;
    }
  }
</style>
