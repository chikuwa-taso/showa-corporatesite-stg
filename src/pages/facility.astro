---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LinkButton from '../components/LinkButton.astro';
import SectionRail from '../components/SectionRail.astro';
import { asset, route } from '../lib/asset';
import { DEPARTMENTS } from '../data/facility';

/** Frames are measured on the 7681px board; 76.81 board px is 1vw. */
const BOARD_PER_VW = 76.81;
const FRAME_H = 1004;

/** Phone-only line breaks, used only when they rebuild the PC text exactly. */
const phoneLines = (lines: string[] | undefined, text: string): string[] =>
  lines && lines.join('') === text ? lines : [text];

/** A machine name in pieces that a phone line may break between: after a ／
    or a ・, and before a （ or a …. So a long name breaks between maker and
    model, or between words, never leaving a lone character behind. On PC the
    pieces are plain inline text. */
const nameParts = (name: string): string[] => name.split(/(?<=[／・])|(?=[（…])/);

/** Text cut into runs, the Latin ones flagged: on phones the comp tracks
    letters and figures tighter than kana. On PC the runs are plain text. */
const runs = (text: string): { t: string; latin: boolean }[] =>
  text
    .split(/([A-Za-z0-9][A-Za-z0-9.\-/×]*)/)
    .filter((t) => t !== '')
    .map((t) => ({ t, latin: /^[A-Za-z0-9]/.test(t) }));
---

<BaseLayout
  title="設備一覧｜昭和美術印刷株式会社"
  description="昭和美術印刷の保有設備。オフセット輪転印刷、枚葉印刷、オンデマンド印刷、プリプレス、製本・折加工・PP加工・型抜き加工の各部門の設備を掲載しています。"
  noindex
>
  <SiteHeader activePage="facility" />

  <main class="facility">
    {/* The side column — both rails and the pictogram index — stays put while
        the page scrolls. It shares one grid cell with the content, so it takes
        no room of its own; and because it keeps its real height, sticky lets go
        of it as the black ground ends rather than letting it ride over the
        footer. */}
    <div class="fac-side">
      <SectionRail label="EQUIPMENT" side="left" tone="inverse" class="fac-side__rail fac-side__rail--left" />

      <nav class="fac-nav" aria-label="部門">
        {
          DEPARTMENTS.map((d, i) => (
            <a
              class:list={['fac-nav__item', i === 0 && 'is-active']}
              href={`#fac-${d.id}`}
              data-fac-nav={d.id}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <picture>
                <source srcset={asset(`/assets/facility/icon-${d.icon}.webp`)} type="image/webp" />
                <img src={asset(`/assets/facility/icon-${d.icon}.png`)} alt={d.title} />
              </picture>
            </a>
          ))
        }
      </nav>

      <SectionRail label="設備一覧" side="right" tone="inverse" class="fac-side__rail fac-side__rail--right" />
    </div>

    <div class="facility__content">
      {
        DEPARTMENTS.map((d) => (
          <section class="dept" id={`fac-${d.id}`} data-fac-section={d.id} aria-labelledby={`fac-${d.id}-title`}>
            <header class="dept__head">
              <picture>
                <source srcset={asset(`/assets/facility/icon-${d.icon}.webp`)} type="image/webp" />
                <img class="dept__icon" src={asset(`/assets/facility/icon-${d.icon}.png`)} alt="" />
              </picture>
              <p class="dept__tag">
                <span class="pc-t">{d.tagline}</span>
                <span class="sp-t">
                  {phoneLines(d.tagLines, d.tagline).map((line, i) => (<>{i > 0 && <br />}{line}</>))}
                </span>
              </p>
              <h2
                class="dept__title"
                id={`fac-${d.id}-title`}
                style={d.phoneTitleTrack ? `--title-track:${d.phoneTitleTrack}` : undefined}
              >
                <span class="pc-t">{d.title}</span>
                <span class="sp-t">
                  {phoneLines(d.titleLines, d.title).map((line, i) => (<>{i > 0 && <br />}{line}</>))}
                </span>
              </h2>
            </header>

            <div class:list={['dept__tree', !d.body && 'dept__tree--bare']}>
              {d.body && (
                <div class="dept__intro">
                  {d.body.map((line) => (
                    <p>
                      <span class="pc-t">{line}</span>
                      <span class="sp-t">{runs(line).map((r) => (r.latin ? <span class="lt">{r.t}</span> : r.t))}</span>
                    </p>
                  ))}
                </div>
              )}

              <ul class="dept__machines">
                {d.machines.map((m) => (
                  <li class:list={['machine', m.photo && 'machine--photo']}>
                    <p class="machine__head">
                      <span class="machine__name">
                        <span class="pc-t">{m.name}</span>
                        <span class="sp-t">
                          {nameParts(m.name).map((part) => (
                            <span class:list={['machine__name-part', part.startsWith('（') && 'machine__name-part--paren']}>
                              {runs(part).map((r) => (r.latin ? <span class="lt">{r.t}</span> : r.t))}
                            </span>
                          ))}
                        </span>
                      </span>
                      {m.spec && (
                        <span class="machine__spec">
                          <span class="pc-t">{m.spec}</span>
                          <span class="sp-t">{runs(m.spec).map((r) => (r.latin ? <span class="lt">{r.t}</span> : r.t))}</span>
                        </span>
                      )}
                    </p>
                    {m.notes && (
                      <div class="machine__notes">
                        {m.notes.map((n) => (
                          <p class="machine__note">
                            <span class="pc-t">{n}</span>
                            <span class="sp-t">{runs(n).map((r) => (r.latin ? <span class="lt">{r.t}</span> : r.t))}</span>
                          </p>
                        ))}
                      </div>
                    )}
                    {m.photo && (
                      <div
                        class="machine__frame"
                        style={`--frame-w:${(m.photo.boardW / BOARD_PER_VW).toFixed(2)}vw;--frame-ratio:${m.photo.boardW} / ${FRAME_H}`}
                      >
                        <img
                          src={asset(`/assets/facility/${m.photo.src}.webp`)}
                          alt={m.photo.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>
  </main>

  <footer class="page-footer">
    <LinkButton href={route('/#top')}>トップへ戻る</LinkButton>
  </footer>
</BaseLayout>

<script>
  import { initFacilityNav } from '../scripts/facility-nav';

  initFacilityNav();
</script>

<style>
  .facility {
    position: relative;
    display: grid;
    background: var(--fac-ground);
    color: var(--fac-ink);
  }

  .fac-side,
  .facility__content {
    grid-area: 1 / 1;
  }

  .page-footer {
    display: flex;
    justify-content: center;
    padding: var(--space-9) 0 var(--space-10);
    background: var(--surface-page);
  }

  /* ---------------------------------------------------------------- side */

  .fac-side {
    --side-h: calc(var(--fac-side-centre) + 2 * var(--fac-nav-pitch) + var(--fac-nav-ring));
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    align-self: start;
    height: var(--side-h);
    pointer-events: none;
  }

  /* Each rail is a band twice the inset wide pinned to its edge, so its label
     centres one inset in — the arrangement WORKS and NETWORK use — and on the
     same line as the middle pictogram. SectionRail's root is another
     component's element, hence :global. */
  .fac-side :global(.fac-side__rail) {
    position: absolute;
    top: var(--fac-side-centre);
    width: 10%;
    padding: 0;
    transform: translateY(-50%);
  }

  .fac-side :global(.fac-side__rail--left) {
    left: 0;
  }

  .fac-side :global(.fac-side__rail--right) {
    right: 0;
  }

  .fac-nav {
    position: absolute;
    left: calc(var(--fac-nav-x) - var(--fac-nav-ring) / 2);
    top: calc(var(--fac-side-centre) - 2 * var(--fac-nav-pitch) - var(--fac-nav-ring) / 2);
    display: flex;
    flex-direction: column;
    gap: calc(var(--fac-nav-pitch) - var(--fac-nav-ring));
    pointer-events: auto;
  }

  /* The ring is the item's own border, transparent until it is the section in
     view, so marking one never moves anything. */
  .fac-nav__item {
    display: grid;
    place-items: center;
    width: var(--fac-nav-ring);
    height: var(--fac-nav-ring);
    border: var(--fac-stroke) solid transparent;
    border-radius: 50%;
    box-sizing: border-box;
    transition: border-color var(--dur-fast) var(--ease-brand);
  }

  .fac-nav__item.is-active {
    border-color: var(--fac-ink);
  }

  .fac-nav__item:hover {
    opacity: var(--hover-opacity);
  }

  .fac-nav__item :global(picture),
  .fac-nav__item img {
    display: block;
  }

  .fac-nav__item img {
    height: var(--fac-nav-icon);
    width: auto;
  }

  /* -------------------------------------------------------------- content */

  .facility__content {
    padding: var(--fac-page-top) 0 var(--fac-page-bottom) var(--fac-tree-x);
  }

  .dept {
    /* Land a jump from the index where the comp puts a heading: the same depth
       below the header as the first one sits on load. */
    scroll-margin-top: var(--fac-page-top);
  }

  .dept + .dept {
    margin-top: var(--fac-section-gap);
  }

  /* Pictogram on the rule's line, tagline and title one column across; the
     tagline's top on the pictogram's top. */
  .dept__head {
    position: relative;
    min-height: var(--fac-icon);
    padding-left: var(--fac-head-x);
  }

  .dept__head :global(picture) {
    position: absolute;
    left: 0.21vw; /* x 1823, a hair right of the rule */
    top: 0;
  }

  .dept__icon {
    display: block;
    height: var(--fac-icon);
    width: auto;
  }

  .dept__tag {
    margin: 0;
    font-size: var(--fac-tag-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--fac-tag-track);
  }

  .dept__title {
    margin: calc(var(--fac-title-top) - var(--fac-tag-size)) 0 0;
    font-size: var(--fac-title-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--fac-title-track);
  }

  /* ----------------------------------------------------------------- tree */

  .dept__tree {
    margin-top: var(--fac-head-to-tree);
  }

  /* The body and the divider under it make one corner: the tree's rule on the
     left, the divider along the bottom, meeting square. */
  .dept__intro {
    width: var(--fac-tree-w);
    box-sizing: border-box;
    padding: 0 0 var(--fac-body-to-divider) var(--fac-text-x);
    border-left: var(--fac-stroke) solid var(--fac-ink);
    border-bottom: var(--fac-stroke) solid var(--fac-ink);
  }

  .dept__intro p {
    margin: 0;
    font-size: var(--fac-body-size);
    font-weight: var(--fw-medium);
    line-height: var(--fac-body-line);
    letter-spacing: var(--fac-body-track);
  }

  .dept__intro p:first-child {
    margin-top: calc(-1 * var(--fac-body-lift));
  }

  /* The comp's line breaks are deliberate — each entry is one line, and the
     longest (枚葉's third) runs a little past the divider's end in the comp
     itself. So lines do not re-wrap while the type is still at the comp's share
     of the window. Below 1200px the 11px floor takes over, the text no longer
     scales with the column, and it is allowed to wrap. */
  @media (min-width: 1200px) {
    .dept__intro p {
      white-space: nowrap;
    }
  }

  .dept__machines {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each item carries its own length of the rule (::before, full height) and
     its stub (::after, on the name's centre line); the last one's rule stops at
     its stub, which closes the tree into an └. --pt is the item's top padding,
     named so both pseudo-elements can find the name's line from it. */
  .machine {
    --pt: var(--fac-item-gap);
    position: relative;
    padding: var(--pt) 0 0 var(--fac-text-x);
  }

  .machine:first-child {
    --pt: var(--fac-divider-to-first);
  }

  .dept__tree--bare .machine:first-child {
    --pt: var(--fac-tree-to-first);
  }

  .machine--photo + .machine {
    --pt: var(--fac-after-frame);
  }

  .machine::before,
  .machine::after {
    content: '';
    position: absolute;
    left: 0;
    background: var(--fac-ink);
  }

  .machine::before {
    top: 0;
    bottom: 0;
    width: var(--fac-stroke);
  }

  .machine:last-child::before {
    bottom: auto;
    height: calc(var(--pt) + var(--fac-name-size) / 2 + var(--fac-stroke) / 2);
  }

  .machine::after {
    top: calc(var(--pt) + var(--fac-name-size) / 2 - var(--fac-stroke) / 2);
    width: var(--fac-stub);
    height: var(--fac-stroke);
  }

  .machine__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--fac-spec-gap);
    margin: 0;
  }

  .machine__name {
    font-size: var(--fac-name-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--fac-name-track);
  }

  .machine__spec {
    font-size: var(--fac-body-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--fac-spec-track);
  }

  .machine__note {
    margin: 0;
    font-size: var(--fac-note-size);
    font-weight: var(--fw-medium);
    line-height: var(--fac-note-line);
    letter-spacing: var(--fac-note-track);
  }

  .machine__head + .machine__notes {
    margin-top: var(--fac-name-to-notes);
  }

  .machine__frame {
    width: var(--frame-w);
    max-width: 100%;
    aspect-ratio: var(--frame-ratio);
    margin-top: var(--fac-to-frame);
    border: var(--fac-stroke) solid var(--fac-ink);
    box-sizing: border-box;
  }

  .machine__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --------------------------------------------------------------- mobile */

  /* Each piece of copy is set twice: as one unbroken run for PC (.pc-t),
     exactly as before, and with the phone comp's line breaks and Latin runs
     for phones (.sp-t). Breaking the PC run into elements would re-shape it
     and move glyphs by a sub-pixel, so the two never share markup. Only one is
     ever displayed, so a screen reader meets each text once. */
  .sp-t {
    display: none;
  }

  @media (max-width: 768px) {
    .pc-t {
      display: none;
    }

    .sp-t {
      display: inline;
    }
  }

  /* Phones, per the phone comp (昭和サイト＿スマホ版デザイン＿設備一覧.jpg, a
     375px screen; values in lp.css as --fac-sp-*). The index is a row pinned
     under the header, every department opens on a full-width rule with its
     title beside a large pictogram, the tagline hangs off a bar, the body runs
     the full measure, and the machines branch off a tree underneath. */
  @media (max-width: 768px) {
    .facility {
      display: block;
    }

    .fac-side {
      height: auto;
      padding: var(--fac-sp-nav-top) var(--fac-sp-gutter) var(--fac-sp-nav-bottom);
      background: var(--fac-ground);
    }

    .fac-side :global(.fac-side__rail) {
      display: none;
    }

    .fac-nav {
      position: static;
      flex-direction: row;
      justify-content: space-between;
      gap: 0;
    }

    .fac-nav__item {
      width: var(--fac-sp-ring);
      height: var(--fac-sp-ring);
      border-width: 1px;
    }

    .fac-nav__item img {
      height: var(--fac-sp-nav-icon);
    }

    /* Japanese face throughout, Latin included: the comp's letters and
       figures are proportional (a narrow I), not Adapter Mono's fixed width. */
    .facility__content {
      padding: 0 0 var(--fac-sp-page-bottom);
      font-family: 'Zen Kaku Gothic Antique', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif;
    }

    .lt {
      letter-spacing: var(--lt-track);
    }

    /* Each department opens on its rule, which lands just under the pinned
       index on a jump. */
    .dept {
      margin: 0 var(--fac-sp-gutter);
      padding: var(--fac-sp-head-top) 0 var(--fac-sp-dept-bottom);
      border-top: 1px solid var(--fac-ink);
      scroll-margin-top: var(--fac-sp-index-h);
    }

    .dept + .dept {
      margin-top: 0;
    }

    /* Title at the left, pictogram at the right, the tagline across under
       whichever of the two runs longer. */
    .dept__head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      min-height: 0;
      padding-left: 0;
    }

    .dept__head :global(picture) {
      position: static;
      grid-column: 2;
      grid-row: 1;
      margin-top: var(--fac-sp-icon-top);
    }

    .dept__icon {
      height: var(--fac-sp-icon);
    }

    .dept__title {
      grid-column: 1;
      grid-row: 1;
      margin: 0;
      font-size: var(--fac-sp-title-size);
      line-height: var(--fac-sp-title-line);
      letter-spacing: var(--title-track, var(--fac-sp-title-track));
      white-space: nowrap;
    }

    .dept__tag {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: var(--fac-sp-tag-top);
      padding: var(--fac-sp-tag-pad-top) 0 var(--fac-sp-tag-pad-bottom) var(--fac-sp-tag-x);
      border-left: 1px solid var(--fac-ink);
      font-size: var(--fac-sp-tag-size);
      line-height: var(--fac-sp-tag-line);
      letter-spacing: var(--fac-sp-tag-track);
      white-space: nowrap;
    }

    .dept__tree {
      margin-top: 0;
    }

    /* The body leaves the tree and runs the full measure as one paragraph —
       the PC lines flow together. */
    .dept__intro {
      width: auto;
      margin-top: var(--fac-sp-body-top);
      padding: 0;
      border: 0;
      text-align: justify;
    }

    .dept__intro p {
      display: inline;
      font-size: var(--fac-sp-body-size);
      line-height: var(--fac-sp-body-line);
      letter-spacing: var(--fac-sp-body-track);
      --lt-track: var(--fac-sp-body-lt);
    }

    .dept__intro p:first-child {
      margin-top: 0;
    }

    .dept__machines {
      margin-top: var(--fac-sp-tree-top);
    }

    .dept__tree--bare .dept__machines {
      margin-top: var(--fac-sp-body-top);
    }

    .machine,
    .machine:first-child,
    .dept__tree--bare .machine:first-child {
      --pt: var(--fac-sp-first);
      padding-left: var(--fac-sp-text-x);
    }

    .machine + .machine {
      --pt: var(--fac-sp-item-gap);
    }

    .machine--photo + .machine {
      --pt: var(--fac-sp-after-frame);
    }

    /* The stub and the └ meet the centre of the name's first line. */
    .machine::after {
      top: calc(var(--pt) + var(--fac-sp-name-size) * var(--fac-sp-name-line) / 2 - 0.5px);
      width: var(--fac-sp-stub);
      height: 1px;
    }

    .machine::before {
      width: 1px;
    }

    .machine:last-child::before {
      height: calc(var(--pt) + var(--fac-sp-name-size) * var(--fac-sp-name-line) / 2 + 0.5px);
    }

    /* Name, then the spec on a line of its own. A long name breaks between
       maker and model (after ／) or before a （, never mid-word. */
    .machine__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .machine__name {
      font-size: var(--fac-sp-name-size);
      line-height: var(--fac-sp-name-line);
      letter-spacing: var(--fac-sp-name-track);
      --lt-track: var(--fac-sp-name-lt);
    }

    .machine__name-part {
      display: inline-block;
    }

    /* A fullwidth （ sits at the right of its em, so opening a line it would
       read as an indent; pulled back to the line's start, as in the comp. */
    .machine__name-part--paren {
      margin-left: -0.5em;
    }

    .machine__spec {
      margin-top: var(--fac-sp-spec-top);
      font-size: var(--fac-sp-spec-size);
      line-height: 1.6;
      letter-spacing: var(--fac-sp-spec-track);
      --lt-track: var(--fac-sp-name-lt);
    }

    /* The notes run on as one passage, divided by ／ as in the comp. */
    .machine__notes,
    .machine__head + .machine__notes {
      margin-top: var(--fac-sp-notes-top);
      padding-right: var(--fac-sp-notes-right);
      font-size: var(--fac-sp-note-size);
      line-height: var(--fac-sp-note-line);
      letter-spacing: var(--fac-sp-note-track);
      --lt-track: var(--fac-sp-note-lt);
    }

    .machine__note {
      display: inline;
      font-size: inherit;
      line-height: inherit;
      letter-spacing: inherit;
    }

    .machine__note + .machine__note::before {
      content: ' ／ ';
    }

    /* Every frame the same height; each keeps its own proportions. */
    .machine__frame {
      width: auto;
      height: var(--fac-sp-frame-h);
      margin-top: var(--fac-sp-frame-top);
      border-width: 1px;
    }
  }
</style>
