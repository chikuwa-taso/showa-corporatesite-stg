---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SectionRail from '../components/SectionRail.astro';
import LinkButton from '../components/LinkButton.astro';
import { route } from '../lib/asset';
import type { PageId } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Fixes the header's active nav item — these pages have no scroll-spy. */
  page: PageId;
  sectionId: string;
  railLatin: string;
  railJp: string;
  /** RECRUIT opens tighter than CONTACT. */
  padTop?: string;
}

const {
  title,
  description,
  page,
  sectionId,
  railLatin,
  railJp,
  padTop = 'var(--space-10)',
} = Astro.props;
---

<BaseLayout title={title} description={description} noindex>
  <SiteHeader activePage={page} />

  <main>
    <section id={sectionId} class="page" style={`--page-pad-top:${padTop}`}>
      <SectionRail label={railLatin} side="left" />
      <div class="page__body"><slot /></div>
      <SectionRail label={railJp} side="right" />
    </section>
  </main>

  <footer class="page-footer">
    <LinkButton href={route('/#top')}>トップへ戻る</LinkButton>
  </footer>
</BaseLayout>

<style>
  .page {
    display: grid;
    grid-template-columns: var(--rail-col) 1fr var(--rail-col);
    padding: var(--page-pad-top) 0 var(--space-10);
  }

  /* Content opens on the lockup's right edge rather than in the middle of the
     column, so the fixed mark never sits over it on the way past. The whole
     block moves across together — the pages below align to this edge instead of
     centring, which keeps their internal spacing as it was. */
  .page__body {
    min-width: 0;
    padding-left: calc(var(--logo-clear) - var(--rail-col));
    padding-right: var(--space-6);
  }

  .page-footer {
    display: flex;
    justify-content: center;
    padding: 0 0 var(--space-10);
    background: var(--surface-page);
  }

  @media (max-width: 768px) {
    .page {
      grid-template-columns: 1fr;
      padding: var(--space-9) 0;
    }

    .page :global(.rail) {
      display: none;
    }

    /* The header stacks here and the lockup stays inside its band, so there is
       nothing to clear — back to the ordinary gutter. */
    .page__body {
      padding-left: var(--space-5);
      padding-right: var(--space-5);
    }

    .page-footer {
      padding: 0 var(--space-5) var(--space-9);
    }
  }
</style>
