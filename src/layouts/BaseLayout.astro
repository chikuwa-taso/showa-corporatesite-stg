---
import '../styles/global.css';
import { asset } from '../lib/asset';

interface Props {
  title: string;
  description: string;
  /** Staging deploys stay out of search results until the client signs off. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <link rel="icon" href={asset('/assets/brand/logo.svg')} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Only the weight the site actually sets. The comp is Medium throughout —
        measured off the client's own artwork, where 「印」's ink fills 0.41 of its
        box against 0.42 for this face at 500 (300 gives 0.20, 400 gives 0.31).
        Japanese webfont CSS is enormous — every extra weight is roughly another
        115KB of render-blocking stylesheet — so add one here only when something
        starts using it, or the browser will fake it from the nearest one. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+Antique:wght@500&display=swap"
    />
    {/* 設備一覧 only — the comp sets that page's headings and model numbers in a
        Mincho, the one place the site leaves the gothic. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400&display=swap"
    />
    {/* Adobe Fonts kit carrying Adapter Mono PE Variable, which sets all Latin.
        Domain-locked — the production host must be added to the web project or
        this falls back to system monospace. */}
    <link rel="stylesheet" href="https://use.typekit.net/pxu0snp.css" />
  </head>

  <body>
    <slot />
  </body>
</html>
